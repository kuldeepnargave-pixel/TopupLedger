{
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=topupledger;User=topupledger;Password=REPLACE_ME;CharSet=utf8mb4;"
  },
  "Secrets": {
    "MasterKey": "REPLACE_WITH_32_BYTE_RANDOM_HEX_OR_BASE64_STRING_FOR_AES_GCM"
  },
  "AdminApi": {
    "AdminApiKey": "REPLACE_WITH_RANDOM_32_CHAR_STRING_FOR_REPORT_API_AUTH"
  },
  "OperatorCallbacks": {
    "Tokens": {
      "etisalat": "REPLACE_WITH_ETISALAT_CALLBACK_TOKEN",
      "du": "REPLACE_WITH_DU_CALLBACK_TOKEN"
    }
  },
  "OperatorSimulation": {
    "Enabled": true,
    "SuccessProbability": 0.85,
    "FailedProbability": 0.10,
    "MinDelaySeconds": 1,
    "MaxDelaySeconds": 15,
    "ExpireAfterSeconds": 120,
    "ExpirePollSeconds": 5,
    "CallbackBaseUrl": "http://localhost:8080"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
