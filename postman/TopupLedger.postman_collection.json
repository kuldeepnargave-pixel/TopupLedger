{
  "info": {
    "name": "TopupLedger",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "TopupLedger B2B Mobile Top-up API.\n\nConfigure these collection variables before testing:\n- baseUrl: http://localhost:8080\n- partnerApiKey: YOUR_NEW_ROTATED_PARTNER_API_KEY\n- partnerSecret: YOUR_NEW_ROTATED_PARTNER_SECRET\n- adminApiKey: dev-admin-api-key (if enabled in your local API)\n- etisalatToken: dev-operator-token-etisalat\n- duToken: dev-operator-token-du\n\nPartner HMAC signature format:\nMETHOD\\nPATH\\nX-Timestamp\\nIdempotency-Key\\nSHA256(rawBody)\n\nThe collection pre-request script signs only /api/v1/partner/* requests. Operator callbacks and reports use their own authentication."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "partnerApiKey",
      "value": "pk_live_1bedbaa8f460c8e365af0431"
    },
    {
      "key": "partnerSecret",
      "value": "sk_live_11851bc6c72071c15ad5b44011c86bec081cb7fd"
    },
    {
      "key": "adminApiKey",
      "value": "dev-admin-api-key"
    },
    {
      "key": "etisalatToken",
      "value": "dev-operator-token-etisalat"
    },
    {
      "key": "duToken",
      "value": "dev-operator-token-du"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// TopupLedger Partner API - HMAC SHA256",
          "// Runs only for /api/v1/partner/* requests.",
          "",
          "const method = pm.request.method.toUpperCase();",
          "const path = \"/\" + (pm.request.url.path || []).join(\"/\");",
          "",
          "if (!path.startsWith(\"/api/v1/partner/\")) {",
          "    console.log(\"HMAC skipped for:\", path);",
          "} else {",
          "    const timestamp = Math.floor(Date.now() / 1000).toString();",
          "",
          "    let idemKey = pm.request.headers.get(\"Idempotency-Key\");",
          "    if (method === \"POST\" && !idemKey) {",
          "        idemKey = pm.variables.replaceIn(\"{{$guid}}\");",
          "        pm.request.headers.add({ key: \"Idempotency-Key\", value: idemKey });",
          "    }",
          "    idemKey = idemKey || \"\";",
          "",
          "    let body = \"\";",
          "    if (pm.request.body && pm.request.body.raw) {",
          "        body = pm.request.body.raw;",
          "    }",
          "",
          "    const bodySha256 = CryptoJS.SHA256(body).toString();",
          "    const stringToSign = [method, path, timestamp, idemKey, bodySha256].join(\"\\n\");",
          "",
          "    const secret = pm.variables.get(\"partnerSecret\");",
          "    const apiKey = pm.variables.get(\"partnerApiKey\");",
          "    if (!secret || !apiKey || secret.startsWith(\"YOUR_NEW_\") || apiKey.startsWith(\"YOUR_NEW_\")) {",
          "        throw new Error(\"Configure partnerApiKey and partnerSecret with your newly rotated credentials.\");",
          "    }",
          "",
          "    const signature = CryptoJS.HmacSHA256(stringToSign, secret).toString(CryptoJS.enc.Hex);",
          "",
          "    pm.request.headers.upsert({ key: \"X-Api-Key\", value: apiKey });",
          "    pm.request.headers.upsert({ key: \"X-Timestamp\", value: timestamp });",
          "    pm.request.headers.upsert({ key: \"X-Signature\", value: signature });",
          "",
          "    console.log(\"HMAC Path:\", path);",
          "    console.log(\"String-to-sign:\", JSON.stringify(stringToSign));",
          "    console.log(\"Body SHA256:\", bodySha256);",
          "    console.log(\"HMAC signature generated.\");",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Partner API",
      "item": [
        {
          "name": "Create top-up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/partner/topups",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"msisdn\": \"0501234567\",\n  \"amount\": \"25.00\",\n  \"operator\": \"ETISALAT\",\n  \"clientRef\": \"RTL-000981\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get top-up by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/partner/topups/1"
          }
        },
        {
          "name": "List top-ups (keyset pagination)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/partner/topups?limit=20&status=PENDING"
          }
        },
        {
          "name": "Wallet balance + last 20 ledger entries",
          "request": {
