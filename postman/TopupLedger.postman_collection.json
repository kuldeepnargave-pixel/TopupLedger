          "name": "Get settlement for business day",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/partner/settlements/2026-10-12"
          }
        }
      ]
    },
    {
      "name": "Operator callbacks (separate auth)",
      "item": [
        {
          "name": "etisalat callback - SUCCESS",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.upsert({ key: 'X-Operator-Token', value: pm.variables.get('etisalatToken') });",
                  "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/operator/callbacks/etisalat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operatorTxnId\": \"ETS-TEST-1\",\n  \"topupId\": 1,\n  \"status\": \"SUCCESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "du callback - FAILED",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.upsert({ key: 'X-Operator-Token', value: pm.variables.get('duToken') });",
                  "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/operator/callbacks/du",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operatorTxnId\": \"DU-TEST-2\",\n  \"topupId\": 2,\n  \"status\": \"FAILED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
