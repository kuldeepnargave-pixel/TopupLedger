@model CreatePartnerViewModel
@{
    ViewData["Title"] = "Create partner";
}

<h2>Create partner</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DistributorId" class="form-label"></label>
        <input asp-for="DistributorId" type="number" class="form-control" />
        <span asp-validation-for="DistributorId" class="text-danger"></span>
        <small class="text-muted">Optional: ID of an existing partner who is the distributor (earns distributor commission).</small>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
