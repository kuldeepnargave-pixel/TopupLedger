@model List<Dictionary<string, object>>
@{
    ViewData["Title"] = "PartnersTop";
}
<h2>PartnersTop</h2>
@if (Model.Count > 0) {
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead><tr>@foreach (var c in Model[0].Keys) { <th>@c</th> }</tr></thead>
            <tbody>
                @foreach (var r in Model) {
                    <tr>
                        @foreach (var c in Model[0].Keys) {
                            var v = r.TryGetValue(c, out var val) ? val : null;
                            <td>@(v == null ? "" : v is DateTime dt ? dt.ToString("yyyy-MM-dd HH:mm:ss") : v is long l ? l.ToString("N0") : v is decimal d ? d.ToString("N2") : v.ToString())</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
} else {
    <div class="alert alert-info">No data.</div>
}
