@model List<Dictionary<string, object>>
@{
    ViewData["Title"] = "Wallets as-of";
}
<h2>Wallet balances as-of a past instant</h2>
<p class="text-muted">Calculated from the wallet ledger (not the current balance column). VIEWER cannot access this report.</p>
@if (Model.Count > 0) {
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead><tr>@foreach (var c in Model[0].Keys) { <th>@c</th> }</tr></thead>
            <tbody>
                @foreach (var r in Model) {
                    <tr>
                        @foreach (var c in Model[0].Keys) {
                            var v = r.TryGetValue(c, out var val) ? val : null;
                            <td>@(v == null ? "" : v is long l ? l.ToString("N0") : v.ToString())</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
} else {
    <div class="alert alert-info">No data.</div>
}
