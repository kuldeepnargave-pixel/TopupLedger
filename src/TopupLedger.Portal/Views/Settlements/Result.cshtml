@model IReadOnlyList<TopupLedger.Application.DTOs.SettlementResponse>
@{
    ViewData["Title"] = "Settlements - Result";
}

<h2>Settlements generated</h2>

<table class="table table-sm table-striped">
    <thead><tr><th>Partner</th><th>Business day</th><th>Success</th><th>Failed</th><th>Expired</th><th>Face value</th><th>Retailer comm.</th><th>Distributor share</th><th>Net debit</th></tr></thead>
    <tbody>
        @foreach (var s in Model) {
            <tr>
                <td>@s.PartnerName</td>
                <td>@s.BusinessDate.ToString("yyyy-MM-dd")</td>
                <td>@s.SuccessCount</td>
                <td>@s.FailedCount</td>
                <td>@s.ExpiredCount</td>
                <td>@s.TotalFaceValueAed AED</td>
                <td>@s.TotalRetailerCommissionAed AED</td>
                <td>@s.TotalDistributorShareAed AED</td>
                <td>@s.NetDebitAed AED</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="9" class="text-muted">No settlements.</td></tr> }
    </tbody>
</table>
<a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back</a>
