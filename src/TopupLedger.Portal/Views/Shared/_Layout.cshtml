<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TopupLedger</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f8f9fa; }
        .money-fils { font-family: monospace; color: #6c757d; font-size: 0.85em; }
        table.tbl-reports th, table.tbl-reports td { white-space: nowrap; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">TopupLedger Admin</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Partners" asp-action="Index">Partners</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Transactions" asp-action="Index">Transactions</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Reconciliation" asp-action="Index">Reconciliation</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Settlements" asp-action="Index">Settlements</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">Reports</a>
                        <ul class="dropdown-menu">
                            <li><h6 class="dropdown-header">Reports</h6></li>
                            <li><a class="dropdown-item" asp-controller="Reports" asp-action="DailySummary">1. Daily summary</a></li>
                            <li><a class="dropdown-item" asp-controller="Reports" asp-action="Operators">2. Operators</a></li>
                            <li><a class="dropdown-item" asp-controller="Reports" asp-action="PartnersTop">3. Partners top</a></li>
                            <li><a class="dropdown-item" asp-controller="Reports" asp-action="Commission">4. Commission</a></li>
                            @if (User.IsInRole("ADMIN")) {
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="Wallets">5. Wallets as-of (ADMIN)</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="WalletStatement">6. Wallet statement (ADMIN)</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Reports" asp-action="Hourly">7. Hourly</a></li>
                            <li><a class="dropdown-item" asp-controller="Reports" asp-action="Failures">8. Failures</a></li>
                            <li><a class="dropdown-item" asp-controller="Reports" asp-action="Reconciliation">9. Reconciliation files</a></li>
                            <li><a class="dropdown-item" asp-controller="Reports" asp-action="PartnersInactive">10. Inactive partners</a></li>
                        </ul>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true) {
                        <li class="nav-item"><span class="navbar-text text-light me-3">@User.Identity.Name <span class="badge bg-secondary">@(User.IsInRole("ADMIN") ? "ADMIN" : "VIEWER")</span></span></li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
                            </form>
                        </li>
                    } else {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @if (TempData["Result"] is string msg) {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @msg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </div>

    <footer class="container text-muted small mt-5 mb-3">
        <hr />
        TopupLedger MVC Portal &middot; ASP.NET Core 8 &middot; money stored as integer fils (BIGINT)
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
